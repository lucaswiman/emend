{
  "tools": [
    {
      "name": "search",
      "description": "Search for code patterns or symbols in Python files.\n\nMode is auto-detected from the query:\n- Pattern mode: query has $-metavars ('print($X)') or isn't a valid\n  symbol selector ('assert False', 'import os')\n- Lookup mode: query is a symbol selector ('MyClass.method', 'func[params]')\n- Summary mode: query is a bare file/dir path with no filters\n\nFor pattern searches, set ``files`` to scope the search. For symbol\nlookups, embed the file in the query ('file.py::func') or set ``files``.\n",
      "inputSchema": {
        "properties": {
          "query": {
            "description": "What to search for. Can be: (1) a code pattern with $-metavars: 'print($X)', 'assert $A == $B'; (2) a literal code pattern: 'assert False', 'import os'; (3) a symbol selector: 'MyClass.method', 'func[params]'; (4) a file/dir path for symbol summary. The file scope can be embedded with :: (e.g. 'src/::print($X)') but prefer using the separate 'files' parameter instead.",
            "title": "Query",
            "type": "string"
          },
          "files": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "File scope: a file path, glob pattern, or directory. Examples: 'src/', '**/*.py', 'file.py'. Defaults to current directory (all Python files).",
            "title": "Files"
          },
          "kind": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Symbol kind filter: function, method, class, async_function, async_method.",
            "title": "Kind"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Name pattern filter (glob like 'test_*' or /regex/).",
            "title": "Name"
          },
          "returns": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Return type filter.",
            "title": "Returns"
          },
          "depth": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Nesting depth filter (lookup) or display depth (summary).",
            "title": "Depth"
          },
          "has_param": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Parameter filter.",
            "title": "Has Param"
          },
          "output": {
            "default": "code",
            "description": "Output format: code, location, selector, summary, metadata, json, count, code::dedent, summary::flat.",
            "title": "Output",
            "type": "string"
          },
          "where": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Scope constraint: 'def', 'class', 'def test_*', 'not class', 'MyClass.method', '@decorator'.",
            "title": "Where"
          },
          "imported_from": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Only match when root name is imported from this module.",
            "title": "Imported From"
          },
          "scope_local": {
            "default": false,
            "description": "Only match locally-defined names, exclude imports.",
            "title": "Scope Local",
            "type": "boolean"
          },
          "case_insensitive": {
            "default": false,
            "description": "Case-insensitive matching.",
            "title": "Case Insensitive",
            "type": "boolean"
          },
          "smart_case": {
            "default": false,
            "description": "Match naming convention variants (snake_case/camelCase/etc).",
            "title": "Smart Case",
            "type": "boolean"
          }
        },
        "required": [
          "query"
        ],
        "title": "searchArguments",
        "type": "object"
      }
    },
    {
      "name": "replace",
      "description": "Replace pattern matches in Python file(s).\n\nSupports $X metavariables in both pattern and replacement.\nBy default shows a diff (dry-run). Set apply=True to write changes.\n",
      "inputSchema": {
        "properties": {
          "pattern": {
            "description": "Pattern to find (e.g. 'print($X)').",
            "title": "Pattern",
            "type": "string"
          },
          "replacement": {
            "description": "Replacement pattern using same $X captures (e.g. 'logger.info($X)').",
            "title": "Replacement",
            "type": "string"
          },
          "path": {
            "description": "Python file, glob, or directory to modify.",
            "title": "Path",
            "type": "string"
          },
          "apply": {
            "default": false,
            "description": "Write changes to disk. Default is dry-run.",
            "title": "Apply",
            "type": "boolean"
          },
          "where": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Scope constraint: 'def test_*', 'not class', 'MyClass.method'.",
            "title": "Where"
          }
        },
        "required": [
          "pattern",
          "replacement",
          "path"
        ],
        "title": "replaceArguments",
        "type": "object"
      }
    },
    {
      "name": "modify",
      "description": "Modify a symbol component: set its value, add to a list, or remove it.\n\nModes:\n- set: Replace a component's value (e.g. change return type, replace params)\n- add: Insert into a list component (params, bases, decorators). Use before/after/at for positioning.\n- remove: Delete a component or entire symbol\n",
      "inputSchema": {
        "properties": {
          "selector": {
            "description": "Symbol selector with component (e.g. 'file.py::func[returns]', 'file.py::func[params]', 'file.py::Class[bases]').",
            "title": "Selector",
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "New value. Required for 'set' and 'add' modes. Omit for 'remove'.",
            "title": "Value"
          },
          "mode": {
            "default": "set",
            "description": "Operation: 'set' replaces a component value, 'add' inserts into a list component (params/bases/decorators), 'remove' deletes the component or symbol.",
            "title": "Mode",
            "type": "string"
          },
          "before": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Insert before this named item (add mode only).",
            "title": "Before"
          },
          "after": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Insert after this named item (add mode only).",
            "title": "After"
          },
          "at": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Insert at position, 0-indexed (add mode only).",
            "title": "At"
          },
          "apply": {
            "default": false,
            "description": "Write changes to disk. Default is dry-run.",
            "title": "Apply",
            "type": "boolean"
          }
        },
        "required": [
          "selector"
        ],
        "title": "modifyArguments",
        "type": "object"
      }
    },
    {
      "name": "refs",
      "description": "Find all references to a symbol across the project. Returns JSON.",
      "inputSchema": {
        "properties": {
          "selector": {
            "description": "Symbol selector (e.g. 'file.py::func_name').",
            "title": "Selector",
            "type": "string"
          },
          "exclude_definition": {
            "default": false,
            "description": "Exclude the definition itself from results.",
            "title": "Exclude Definition",
            "type": "boolean"
          },
          "exclude_imports": {
            "default": false,
            "description": "Exclude import statements from results.",
            "title": "Exclude Imports",
            "type": "boolean"
          },
          "writes_only": {
            "default": false,
            "description": "Only show write (assignment) references.",
            "title": "Writes Only",
            "type": "boolean"
          },
          "reads_only": {
            "default": false,
            "description": "Only show read (load) references.",
            "title": "Reads Only",
            "type": "boolean"
          },
          "calls_only": {
            "default": false,
            "description": "Only show actual call sites.",
            "title": "Calls Only",
            "type": "boolean"
          },
          "project": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Project root directory.",
            "title": "Project"
          }
        },
        "required": [
          "selector"
        ],
        "title": "refsArguments",
        "type": "object"
      }
    },
    {
      "name": "rename",
      "description": "Rename a symbol or module across the project, updating all references.",
      "inputSchema": {
        "properties": {
          "selector": {
            "description": "Symbol selector (file.py::name) or module path (file.py). Uses :: for symbols, bare path for modules.",
            "title": "Selector",
            "type": "string"
          },
          "to": {
            "description": "New name for the symbol or module.",
            "title": "To",
            "type": "string"
          },
          "apply": {
            "default": false,
            "description": "Write changes to disk. Default is dry-run.",
            "title": "Apply",
            "type": "boolean"
          },
          "docs": {
            "default": false,
            "description": "Also rename in docstrings (symbol mode only).",
            "title": "Docs",
            "type": "boolean"
          },
          "no_hierarchy": {
            "default": false,
            "description": "Don't rename in class hierarchy (symbol mode only).",
            "title": "No Hierarchy",
            "type": "boolean"
          },
          "unsure": {
            "default": false,
            "description": "Rename uncertain occurrences (symbol mode only).",
            "title": "Unsure",
            "type": "boolean"
          },
          "project": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Project root directory.",
            "title": "Project"
          }
        },
        "required": [
          "selector",
          "to"
        ],
        "title": "renameArguments",
        "type": "object"
      }
    },
    {
      "name": "move",
      "description": "Move (or copy) a symbol or module to another file, updating all imports.\n\nSet copy_only=True to copy a symbol without removing it from the source file.\n",
      "inputSchema": {
        "properties": {
          "selector": {
            "description": "Symbol selector (file.py::name) or module path (file.py). Uses :: for symbols, bare path for modules.",
            "title": "Selector",
            "type": "string"
          },
          "destination": {
            "description": "Destination file or package.",
            "title": "Destination",
            "type": "string"
          },
          "copy_only": {
            "default": false,
            "description": "Copy without removing from source (symbol mode only). The body is copied exactly from the AST.",
            "title": "Copy Only",
            "type": "boolean"
          },
          "dedent": {
            "default": false,
            "description": "Dedent nested symbols (symbol mode only).",
            "title": "Dedent",
            "type": "boolean"
          },
          "no_update_imports": {
            "default": false,
            "description": "Don't update imports across the project (symbol mode only).",
            "title": "No Update Imports",
            "type": "boolean"
          },
          "apply": {
            "default": false,
            "description": "Write changes to disk. Default is dry-run.",
            "title": "Apply",
            "type": "boolean"
          },
          "project": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Project root directory (module mode only).",
            "title": "Project"
          }
        },
        "required": [
          "selector",
          "destination"
        ],
        "title": "moveArguments",
        "type": "object"
      }
    },
    {
      "name": "graph",
      "description": "Generate a call graph for functions in a Python file.",
      "inputSchema": {
        "properties": {
          "file_path": {
            "description": "Python file to analyze.",
            "title": "File Path",
            "type": "string"
          },
          "format": {
            "default": "json",
            "description": "Output format: plain, json, or dot (Graphviz).",
            "title": "Format",
            "type": "string"
          },
          "project": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Project root directory.",
            "title": "Project"
          }
        },
        "required": [
          "file_path"
        ],
        "title": "graphArguments",
        "type": "object"
      }
    },
    {
      "name": "deadcode",
      "description": "Find potentially dead (unreferenced) code. Returns JSON.\n\nSkips dunder methods, test functions, decorated entry points,\n__all__ members, and conventional entry points.\n\nUse entry_point_decorators and entry_point_names to add custom\nexclusions beyond the built-in heuristics.\n",
      "inputSchema": {
        "properties": {
          "path": {
            "default": ".",
            "description": "Project directory to scan.",
            "title": "Path",
            "type": "string"
          },
          "kind": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Symbol kind filter: function, class.",
            "title": "Kind"
          },
          "include_private": {
            "default": false,
            "description": "Include _private symbols.",
            "title": "Include Private",
            "type": "boolean"
          },
          "exclude_references_from": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Directories to ignore when scanning for references.",
            "title": "Exclude References From"
          },
          "no_strings": {
            "default": false,
            "description": "Don't count string literals as references.",
            "title": "No Strings",
            "type": "boolean"
          },
          "no_last_reference": {
            "default": false,
            "description": "Don't show git last-reference info.",
            "title": "No Last Reference",
            "type": "boolean"
          },
          "all_files": {
            "default": false,
            "description": "Scan all Python files, not just git-tracked ones.",
            "title": "All Files",
            "type": "boolean"
          },
          "entry_point_decorators": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Additional decorator names to treat as entry points.",
            "title": "Entry Point Decorators"
          },
          "entry_point_names": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Additional function/class names to treat as entry points.",
            "title": "Entry Point Names"
          },
          "exclude_paths": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Directories to exclude entirely from dead code analysis.",
            "title": "Exclude Paths"
          }
        },
        "title": "deadcodeArguments",
        "type": "object"
      }
    },
    {
      "name": "lint",
      "description": "Lint Python files using pattern rules from .emend/patterns.yaml.",
      "inputSchema": {
        "properties": {
          "path": {
            "description": "File or directory to lint.",
            "title": "Path",
            "type": "string"
          },
          "config": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Path to patterns.yaml config file (default: .emend/patterns.yaml).",
            "title": "Config"
          },
          "fix": {
            "default": false,
            "description": "Auto-apply fix replacements.",
            "title": "Fix",
            "type": "boolean"
          },
          "rule": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Run only a specific rule by name.",
            "title": "Rule"
          }
        },
        "required": [
          "path"
        ],
        "title": "lintArguments",
        "type": "object"
      }
    },
    {
      "name": "impact",
      "description": "Compute transitive set of impacted symbols from a change.\n\nGiven a changed symbol or git diff, computes impacted symbols,\nfiles, and tests via reverse-caller closure.\n",
      "inputSchema": {
        "properties": {
          "selector": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Symbol selector (file.py::Symbol). Provide this or diff.",
            "title": "Selector"
          },
          "diff": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Git diff spec (e.g. HEAD, abc..def).",
            "title": "Diff"
          },
          "output": {
            "default": "symbols",
            "description": "Output mode: symbols, tests, graph.",
            "title": "Output",
            "type": "string"
          },
          "max_depth": {
            "default": 10,
            "description": "Maximum BFS depth for transitive closure.",
            "title": "Max Depth",
            "type": "integer"
          },
          "project": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Project root directory.",
            "title": "Project"
          }
        },
        "title": "impactArguments",
        "type": "object"
      }
    },
    {
      "name": "semantic_context",
      "description": "Check a symbol for hidden dangers before editing it.\n\nReturns dangers (things you'd miss from just reading the code), plus\na compact summary of callers, side effects, and test coverage.\n\nDanger categories:\n- external_interface: decorator exposes this as API/RPC/CLI (signature = contract)\n- async_side_effect: calls .delay()/.apply_async() (work finishes after return)\n- dynamic_reference: name appears as string literal (renaming won't catch it)\n- high_fan_out: 5+ non-test callers (wide blast radius)\n- caching: @lru_cache etc (mutations may serve stale data)\n- no_test_coverage: no test files call this directly\n",
      "inputSchema": {
        "properties": {
          "selector": {
            "description": "Symbol selector (e.g. 'file.py::func_name', 'file.py::Class.method'). Call this when you're about to change a function/class and want to know what could go wrong \u2014 hidden API contracts, async side effects, dynamic string references, missing tests, caching issues.",
            "title": "Selector",
            "type": "string"
          },
          "project": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Project root directory.",
            "title": "Project"
          },
          "interface_decorators": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Additional decorator names that indicate external interfaces (e.g. 'rpc_endpoint', 'message_handler').",
            "title": "Interface Decorators"
          }
        },
        "required": [
          "selector"
        ],
        "title": "semantic_contextArguments",
        "type": "object"
      }
    },
    {
      "name": "taint",
      "description": "Run taint analysis to detect unsafe data flows.\n\nTracks value flow from sources to sinks within functions.\nSet interprocedural=True for cross-function analysis.\n",
      "inputSchema": {
        "properties": {
          "path": {
            "description": "File or directory to analyze.",
            "title": "Path",
            "type": "string"
          },
          "config": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Path to patterns.yaml (default: .emend/patterns.yaml).",
            "title": "Config"
          },
          "label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Only check a specific taint label.",
            "title": "Label"
          },
          "trace": {
            "default": false,
            "description": "Include propagation traces.",
            "title": "Trace",
            "type": "boolean"
          },
          "interprocedural": {
            "default": false,
            "description": "Enable interprocedural analysis (cross-function taint tracking).",
            "title": "Interprocedural",
            "type": "boolean"
          }
        },
        "required": [
          "path"
        ],
        "title": "taintArguments",
        "type": "object"
      }
    },
    {
      "name": "query_facts",
      "description": "Query the relational fact graph for code invariants.\n\nProvides structured access to symbols, call relationships,\nreferences, taint flows, type information, and imports.\n",
      "inputSchema": {
        "properties": {
          "project": {
            "default": ".",
            "description": "Project root directory.",
            "title": "Project",
            "type": "string"
          },
          "fact_type": {
            "default": "symbols",
            "description": "Fact type to query: symbols, calls, references, taint_flows, types, imports.",
            "title": "Fact Type",
            "type": "string"
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Filter by name (symbols).",
            "title": "Name"
          },
          "kind": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Filter by kind (symbols).",
            "title": "Kind"
          },
          "file_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Filter by file path.",
            "title": "File Path"
          },
          "symbol": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Symbol qualified name (calls/references/types).",
            "title": "Symbol"
          },
          "label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Taint label filter (taint_flows).",
            "title": "Label"
          },
          "transitive": {
            "default": false,
            "description": "Compute transitive closure (calls).",
            "title": "Transitive",
            "type": "boolean"
          },
          "max_depth": {
            "default": 10,
            "description": "Max depth for transitive queries.",
            "title": "Max Depth",
