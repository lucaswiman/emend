" emend.vader — Unit tests for the emend Vim plugin.
"
" These tests verify the VimL/plugin layer.  They don't require a running
" emend server (the RPC integration is tested separately in Python).

" ===========================================================================
" Plugin loading
" ===========================================================================

Execute (plugin is loaded):
  Assert exists('g:loaded_emend'), 'g:loaded_emend should be set'

Execute (commands are defined):
  Assert exists(':Emend'), ':Emend command should exist'
  Assert exists(':EmendSearch'), ':EmendSearch command should exist'
  Assert exists(':EmendOutline'), ':EmendOutline command should exist'
  Assert exists(':EmendRefs'), ':EmendRefs command should exist'
  Assert exists(':EmendStart'), ':EmendStart command should exist'
  Assert exists(':EmendStop'), ':EmendStop command should exist'
  Assert exists(':EmendStatus'), ':EmendStatus command should exist'
  Assert exists(':EmendReindex'), ':EmendReindex command should exist'

Execute (mapping helper exists):
  runtime autoload/emend.vim
  Assert exists('*emend#map_if_free'), 'emend#map_if_free should be callable'

" ===========================================================================
" Configuration defaults
" ===========================================================================

Execute (default config values are set):
  AssertEqual '', g:emend_command
  AssertEqual '', g:emend_project_root
  AssertEqual 1, g:emend_auto_start
  AssertEqual 50, g:emend_limit
  AssertEqual 60, g:emend_preview_height

Execute (config can be overridden):
  let g:emend_limit = 100
  AssertEqual 100, g:emend_limit
  let g:emend_limit = 50

" ===========================================================================
" Server state
" ===========================================================================

Execute (server is not running initially):
  Assert !emend#is_running(), 'server should not be running before start'
  Assert !emend#is_ready(), 'server should not be ready before start'

" ===========================================================================
" UI module loading
" ===========================================================================

Execute (ui module functions are autoloadable):
  " Explicitly source the autoload file — exists('*autoload#fn') does not
  " trigger autoloading on Neovim < 0.10.
  runtime autoload/emend/ui.vim
  Assert exists('*emend#ui#prompt'), 'emend#ui#prompt should be autoloadable'
  Assert exists('*emend#ui#search'), 'emend#ui#search should be autoloadable'
  Assert exists('*emend#ui#on_search_result'), 'emend#ui#on_search_result should be autoloadable'
  Assert exists('*emend#ui#move'), 'emend#ui#move should be autoloadable'
  Assert exists('*emend#ui#accept'), 'emend#ui#accept should be autoloadable'
  Assert exists('*emend#ui#close'), 'emend#ui#close should be autoloadable'

" ===========================================================================
" Search result callback — empty results
" ===========================================================================

Execute (on_search_result handles empty results without crashing):
  " Simulate an empty search result.  Should echo a message, not open UI.
  call emend#ui#on_search_result({'items': [], 'mode': 'symbol', 'elapsed_ms': 1.5, 'query': 'xyz', 'truncated': v:false})
  " If we get here without error, the test passes.

" ===========================================================================
" Search result callback — error response
" ===========================================================================

Execute (on_search_result handles error responses):
  call emend#ui#on_search_result({'error': {'code': -32603, 'message': 'test error'}})
  " Should show error message, not crash.

" ===========================================================================
" Search result callback — successful results open UI
" ===========================================================================

Execute (on_search_result with items opens the UI):
  let result = {
        \ 'items': [
        \   {'name': 'foo', 'kind': 'function', 'file_path': '/tmp/test.py',
        \    'line': 10, 'end_line': 15, 'qualified_name': 'mod.foo',
        \    'signature': '(x, y)', 'score': 1000.0},
        \ ],
        \ 'mode': 'symbol',
        \ 'elapsed_ms': 2.3,
        \ 'query': 'foo',
        \ 'truncated': v:false,
        \ }
  call emend#ui#on_search_result(result)

  " The UI should have opened.  Close it to clean up.
  call emend#ui#close()

" ===========================================================================
" Navigation with multiple results
" ===========================================================================

Execute (navigation through multiple results):
  let result = {
        \ 'items': [
        \   {'name': 'alpha', 'kind': 'function', 'file_path': '/tmp/a.py',
        \    'line': 1, 'end_line': 5, 'qualified_name': 'a.alpha',
        \    'signature': '()', 'score': 900.0},
        \   {'name': 'beta', 'kind': 'function', 'file_path': '/tmp/b.py',
        \    'line': 10, 'end_line': 20, 'qualified_name': 'b.beta',
        \    'signature': '(x)', 'score': 800.0},
        \   {'name': 'gamma', 'kind': 'class', 'file_path': '/tmp/c.py',
        \    'line': 1, 'end_line': 50, 'qualified_name': 'c.gamma',
        \    'signature': '', 'score': 700.0},
        \ ],
        \ 'mode': 'symbol',
        \ 'elapsed_ms': 1.0,
        \ 'query': 'test',
        \ 'truncated': v:false,
        \ }
  call emend#ui#on_search_result(result)

  " Move down.
  call emend#ui#move(1)
  call emend#ui#move(1)

  " Move up.
  call emend#ui#move(-1)

  " Jump to edges.
  call emend#ui#goto_first()
  call emend#ui#goto_last()

  " Clean up.
  call emend#ui#close()

" ===========================================================================
" Phase 1: Provenance display
" ===========================================================================

Execute (provenance is rendered in header when present):
  let result = {
        \ 'items': [
        \   {'name': 'foo', 'kind': 'function', 'file_path': '/tmp/test.py',
        \    'line': 10, 'end_line': 15, 'qualified_name': 'mod.foo',
        \    'signature': '(x, y)', 'score': 1000.0},
        \ ],
        \ 'mode': 'symbol',
        \ 'provenance': 'indexed',
        \ 'elapsed_ms': 2.3,
        \ 'query': 'foo',
        \ 'truncated': v:false,
        \ }
  call emend#ui#on_search_result(result)
  " The UI should open and the header should contain [indexed].
  " If we get here without error, the render succeeded.
  call emend#ui#close()

Execute (provenance absent does not crash):
  let result = {
        \ 'items': [
        \   {'name': 'bar', 'kind': 'function', 'file_path': '/tmp/test.py',
        \    'line': 1, 'end_line': 5, 'qualified_name': 'mod.bar',
        \    'signature': '()', 'score': 900.0},
        \ ],
        \ 'mode': 'symbol',
        \ 'elapsed_ms': 1.0,
        \ 'query': 'bar',
        \ 'truncated': v:false,
        \ }
  call emend#ui#on_search_result(result)
  call emend#ui#close()

" ===========================================================================
" Phase 1: Query history
" ===========================================================================

Execute (search history is saved after search result):
  " Simulate two searches.
  let result1 = {
        \ 'items': [{'name': 'alpha', 'kind': 'function',
        \    'file_path': '/tmp/a.py', 'line': 1, 'end_line': 5,
        \    'qualified_name': 'a.alpha', 'signature': '()', 'score': 900.0}],
        \ 'mode': 'symbol', 'elapsed_ms': 1.0, 'query': 'alpha',
        \ 'truncated': v:false }
  call emend#ui#on_search_result(result1)
  call emend#ui#close()

  let result2 = {
        \ 'items': [{'name': 'beta', 'kind': 'function',
        \    'file_path': '/tmp/b.py', 'line': 10, 'end_line': 20,
        \    'qualified_name': 'b.beta', 'signature': '(x)', 'score': 800.0}],
        \ 'mode': 'symbol', 'elapsed_ms': 1.0, 'query': 'beta',
        \ 'truncated': v:false }
  call emend#ui#on_search_result(result2)
  call emend#ui#close()

  " If we get here without crash, history saving works.
  " (History overlay internals are tested via unit logic, not full UI.)

Execute (history overlay function exists):
  Assert exists('*emend#ui#show_history_overlay'), 'show_history_overlay should exist'
  Assert exists('*emend#ui#history_move'), 'history_move should exist'
  Assert exists('*emend#ui#history_accept'), 'history_accept should exist'
  Assert exists('*emend#ui#history_dismiss'), 'history_dismiss should exist'
  Assert exists('*emend#ui#recall_query'), 'recall_query should exist'

Execute (recall_query updates the interactive picker input):
  call emend#ui#interactive()
  let input_buf = bufnr('%')
  call setline(1, 'draft')
  call emend#ui#recall_query('beta', v:false)
  AssertEqual 'beta', getbufline(input_buf, 1)[0]
  call emend#ui#close()

Execute (show_history_overlay handles empty history gracefully):
  " This should echo a message, not crash.
  call emend#ui#show_history_overlay()

Execute (history overlay caps visible entries at 20):
  let history = map(range(0, 20), 'printf("query_%d", v:val)')
  let lines = emend#ui#history_overlay_lines(history)
  AssertEqual 22, len(lines)
  AssertEqual '  Recent queries  (j/k navigate, Enter select, Esc cancel)', lines[0]

" ===========================================================================
" Default mapping validation
" ===========================================================================

Execute (conflicting default mappings are preserved):
  nnoremap <buffer> <Leader>es <Cmd>echo "user mapping"<CR>
  AssertEqual 0, emend#map_if_free('n', '<Leader>es', '<Cmd>Emend<CR>')
  let mapping = maparg('<Leader>es', 'n', 0, 1)
  AssertEqual '<Cmd>echo "user mapping"<CR>', mapping.rhs

Execute (free mappings can still be installed):
  execute 'nunmap <buffer> <Leader>es'
  AssertEqual 1, emend#map_if_free('n', '<Leader>es', '<Cmd>Emend<CR>')
  let mapping = maparg('<Leader>es', 'n', 0, 1)
  AssertEqual '<Cmd>Emend<CR>', mapping.rhs

" ===========================================================================
" Phase 2: Local outline filtering
" ===========================================================================

Execute (outline mode functions exist):
  Assert exists('*emend#ui#enter_outline'), 'enter_outline should exist'
  Assert exists('*emend#ui#set_outline_items'), 'set_outline_items should exist'
  Assert exists('*emend#ui#has_outline_cache'), 'has_outline_cache should exist'
  Assert exists('*emend#ui#show_cached_outline'), 'show_cached_outline should exist'

Execute (enter_outline opens UI in outline mode):
  call emend#ui#enter_outline('/tmp/test_outline.py')
  " UI should be open; close it to clean up.
  call emend#ui#close()

Execute (set_outline_items populates results and renders):
  " Open outline mode first
  call emend#ui#enter_outline('/tmp/test_outline.py')

  " Populate with file symbols
  let outline_result = {
        \ 'items': [
        \   {'name': 'MyClass', 'kind': 'class', 'file_path': '/tmp/test_outline.py',
        \    'line': 1, 'end_line': 20, 'qualified_name': 'MyClass'},
        \   {'name': 'helper', 'kind': 'function', 'file_path': '/tmp/test_outline.py',
        \    'line': 22, 'end_line': 30, 'qualified_name': 'helper'},
        \   {'name': 'process', 'kind': 'function', 'file_path': '/tmp/test_outline.py',
        \    'line': 32, 'end_line': 40, 'qualified_name': 'process'},
        \ ],
        \ 'mode': 'file_symbols',
        \ 'elapsed_ms': 1.0,
        \ 'query': '/tmp/test_outline.py',
        \ 'truncated': v:false,
        \ }
  call emend#ui#set_outline_items(outline_result)
  call emend#ui#close()

Execute (outline cache invalidates on different changedtick):
  " No cache initially for this file
  Assert !emend#ui#has_outline_cache('/tmp/fresh.py', 42), 'should not have cache for new file'

Execute (set_outline_items handles error result):
  call emend#ui#enter_outline('/tmp/err.py')
  " Error results should not crash
  call emend#ui#set_outline_items({'error': {'code': -1, 'message': 'test'}})
  call emend#ui#close()

" ===========================================================================
" Phase 2: Navigation hotkeys
" ===========================================================================

Execute (navigation action functions exist):
  Assert exists('*emend#ui#action_goto_symbol'), 'action_goto_symbol should exist'
  Assert exists('*emend#ui#action_impact'), 'action_impact should exist'
  Assert exists('*emend#ui#action_callers'), 'action_callers should exist'
  Assert exists('*emend#ui#action_callees'), 'action_callees should exist'

Execute (EmendImpact command exists):
  Assert exists(':EmendImpact'), ':EmendImpact command should exist'

Execute (action_goto_symbol does not crash with no results):
  " With empty results, should just return without error
  call emend#ui#action_goto_symbol()

Execute (action_impact does not crash with no results):
  call emend#ui#action_impact()
